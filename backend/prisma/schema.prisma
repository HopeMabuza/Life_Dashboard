generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(cuid())
  address     String       @unique  // wallet address (e.g. 0xABC...)
  createdAt   DateTime     @default(now())
  tasks       Task[]
  habits      Habit[]
  goals       Goal[]
  reflections Reflection[]
}

model Task {
  id        String   @id @default(cuid())
  title     String
  area      String   // Health | Work | Growth | Finance | Relationships
  priority  String   @default("medium") // low | medium | high
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}

model Habit {
  id             String        @id @default(cuid())
  name           String
  area           String
  streak         Int           @default(0)
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  completions    HabitLog[]
}

model HabitLog {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  habitId   String
}

model Goal {
  id        String   @id @default(cuid())
  title     String
  area      String
  progress  Int      @default(0)  // 0-100
  month     Int                   // e.g. 7 for July
  year      Int                   // e.g. 2026
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}

model Reflection {
  id        String   @id @default(cuid())
  answers   Json                  // array of 5 strings
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}
